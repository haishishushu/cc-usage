      "layout": "vertical",
      "gap": 24,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "YTnY0",
          "name": "标题",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "04   添加连接 / 遮罩先到，弹窗轻落",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 28,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Iu0TY",
          "name": "说明",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "静态分镜 · 复用 19 连接管理中的添加连接弹窗。进入 200 ms，退出 140 ms；中心锚定，缩放 0.98 → 1，位移 +8 px → 0。",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 14,
          "fontWeight": "normal"
