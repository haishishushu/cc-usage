              "fontSize": 16,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "f6c61",
              "name": "Subtitle",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "技术栈：Tauri 2 + Rust + React + TypeScript + Vite + Tailwind CSS + shadcn/ui + SQLite。两套主题使用同一组颜色 / 间距 / 圆角变量，信息结构、尺寸与交互一致；深色分别调整背景、层级表面、文字、分隔线、状态色与焦点边框，不做简单颜色反转。参考尺寸与色值未经对照校准，不标为 Codex 官方设计参数。",
              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
