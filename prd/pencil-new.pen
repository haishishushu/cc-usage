          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "建议曲线 cubic-bezier(0.2, 0.8, 0.2, 1)，无回弹。减少动态效果时取消位移、缩放和高度插值，仅保留 ≤ 80 ms 淡入或立即更新。",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 13,
