                  "name": "N",
                  "fill": "$text-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "在探出状态下双击才进入展开态；对停靠条本身双击 = 解除停靠、回到自由态",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
