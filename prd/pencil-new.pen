            },
            {
              "type": "text",
              "id": "Kpz6v",
              "name": "Note",
              "fill": "$text-tertiary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "· 所有数字使用等宽数字避免刷新抖动；金额仅适度强调，不让每列都加粗。",
              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
