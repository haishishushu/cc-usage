{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Usage",
  "version": "0.1.0",
  "identifier": "dev.ningz.cc-usage",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "island",
        "visible": false,
        "title": "CC Usage",
        "url": "index.html?window=island",
        "width": 428,
        "height": 124,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "x": 760,
        "y": 60
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "copyright": "CC Usage · ningz.dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "headerImage": "./windows/installer/header.bmp",
        "sidebarImage": "./windows/installer/sidebar.bmp",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxMTgxMDg4ODA2RjMwRTYKUldUbU1HK0FpQkFZZ1JZWTdNVlQvcnh5SjB6UTkrZngzd2orS0diR1ZOVllLRFpFOE5WTlhmNVEK",
      "endpoints": [
        "https://github.com/haishishushu/cc-usage/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
